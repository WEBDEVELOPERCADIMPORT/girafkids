---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (homeContent[lang] ?? homeContent.es).hero;
---

<section
  class="relative w-full overflow-hidden bg-cover bg-center bg-no-repeat min-h-[560px] sm:min-h-[600px] lg:min-h-[640px] flex items-center py-10 sm:py-16"
  style={`background-image: url('${t.bgImage || "/images/home/bg-children.png"}');`}
>
  <!-- Máscara de contraste y armonización enfrente del fondo de los niños -->
  <div class="absolute inset-0 bg-stone-950/10 pointer-events-none"></div>
  <div
    class="absolute inset-0 bg-gradient-to-r from-black/15 via-transparent to-black/20 pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-t from-[#FFFBF2]/50 via-transparent to-black/15 pointer-events-none"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <!-- Contenedor con distribución separada (justify-between con espacio amplio entre jirafa y card) -->
    <div
      class="flex flex-col lg:flex-row items-center lg:items-center justify-between gap-8 lg:gap-12 w-full"
    >
      <!-- Lado Izquierdo: Mascota Jirafa con animación de abajo para arriba y sombra amarilla -->
      <div
        class="flex justify-center lg:justify-start items-end relative lg:pl-4"
      >
        <div
          class="relative w-full max-w-[280px] sm:max-w-[320px] lg:max-w-[340px] animate-giraffe-float"
        >
          <!-- Resplandor amarillo de fondo (halo suave) -->
          <div
            class="absolute inset-0 rounded-full bg-yellow-300/30 blur-2xl transform scale-90 pointer-events-none"
          >
          </div>

          <!-- Imagen de la Jirafa con resplandor amarillo alrededor de su silueta -->
          <img
            src={t.giraffeImage || "/images/home/giraffe-hero.png"}
            alt="Girafkids Mascot"
            class="relative z-10 w-full h-auto object-contain filter-yellow-glow transition-transform duration-300 hover:scale-105"
            onerror="this.src='/images/home/giraffe-winter.png'"
          />
        </div>
      </div>

      <!-- Lado Derecho: Card de Acción con Fondo bg-card-action y Textos Localizados -->
      <div class="flex justify-center lg:justify-end w-full lg:w-auto">
        <div
          class="relative w-full max-w-[490px] rounded-[32px] overflow-hidden p-8 sm:p-10 shadow-[0_20px_50px_rgba(0,0,0,0.22)] bg-cover bg-center border border-white/20"
          style={`background-image: url('${t.cardBgImage || "/images/home/bg-card-action.png"}'); background-color: #F59E0B;`}
        >
          <!-- Pequeño destello decorativo en la esquina superior derecha -->
          <div
            class="absolute top-6 right-6 text-white text-xl sm:text-2xl font-light opacity-90 select-none"
          >
            ✦
          </div>

          <!-- Contenido textual 100% dinámico desde los JSONs -->
          <div class="relative z-10 space-y-4">
            <!-- Título Multilínea con Resalte Amarillo -->
            <h1
              class="text-3xl sm:text-4xl md:text-[40px] font-black uppercase leading-[1.08] tracking-tight text-white drop-shadow-sm"
            >
              <span>{t.headingLine1}</span><br />
              <span>{t.headingLine2}</span><br />
              <span
                class="text-[#FFE200] drop-shadow-[0_1px_2px_rgba(0,0,0,0.2)]"
                >{t.headingHighlight}</span
              >
            </h1>

            <!-- Subtítulo / Tagline -->
            <div
              class="pt-1 text-base sm:text-lg font-bold text-white leading-snug drop-shadow-sm"
            >
              <p>{t.taglineLine1}</p>
              <p class="flex items-center gap-1.5">
                <span>{t.taglineLine2}</span>
                <span class="text-white text-xs">✦</span>
              </p>
            </div>

            <!-- Botones de Acción Idénticos al Diseño -->
            <div
              class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5"
            >
              <!-- Botón 1: Comprar en Amazon con Icono de Bolsa -->
              <a
                href={t.primaryCtaUrl || "https://www.amazon.com"}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-[#D9480F] hover:bg-[#C2410C] text-white font-black text-xs sm:text-sm shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 text-center"
              >
                <!-- SVG Ícono de Bolsa de Compra -->
                <svg
                  class="w-4 h-4 fill-none stroke-current"
                  stroke-width="2.2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <span>{t.primaryCta}</span>
              </a>

              <!-- Botón 2: Explorar Catálogo con Flecha Abajo (Fondo Blanco, Texto Naranja) -->
              <a
                href={t.secondaryCtaUrl || "#productos"}
                class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl bg-white hover:bg-amber-50 text-[#D9480F] font-black text-xs sm:text-sm shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 text-center"
              >
                <span>{t.secondaryCta}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sombra / Resplandor amarillo alrededor de la silueta de la jirafa */
  .filter-yellow-glow {
    filter: drop-shadow(0 0 12px rgba(253, 224, 71, 0.85))
      drop-shadow(0 0 24px rgba(245, 158, 11, 0.45))
      drop-shadow(0 10px 18px rgba(0, 0, 0, 0.22));
  }

  /* Animación continua de abajo hacia arriba */
  @keyframes giraffeFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-16px);
    }
  }

  .animate-giraffe-float {
    animation: giraffeFloat 3.2s ease-in-out infinite;
    will-change: transform;
  }
</style>
