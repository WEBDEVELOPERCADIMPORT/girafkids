---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";
import type { ReviewItem } from "../../../actions/reviews/getReviews.action";

interface Props {
  lang: Lang;
  reviews: ReviewItem[];
}

const { lang, reviews } = Astro.props;
const t = (homeContent[lang] ?? homeContent.es).reviews;
---

<section id="opiniones" class="py-16 sm:py-24 bg-[#FFFBF2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header de Reseñas Amazon -->
    <div class="flex flex-col items-center justify-center text-center mb-14 space-y-4">
      
      <!-- Puntuación Global 4.8 con Estrellas y Logo Amazon -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 bg-white px-6 sm:px-8 py-4 rounded-3xl border border-[#F3E5CE] shadow-sm">
        
        <div class="flex items-center gap-2">
          <span class="text-3xl sm:text-4xl font-black text-[#3D2314]">
            {t.score}
          </span>
          <div class="flex text-[#F59E0B] gap-0.5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
        </div>

        <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>

        <!-- Logo amazon REVIEWS -->
        <div class="flex items-center gap-1.5 text-lg font-bold">
          <span class="text-black font-extrabold tracking-tight">amazon</span>
          <span class="text-[#E85D04] uppercase text-xs tracking-wider font-black px-2 py-0.5 bg-orange-50 rounded-md border border-orange-200">Reviews</span>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-[#7C533D] font-medium">
        {t.scoreLabel}
      </p>
    </div>

    <!-- Grid de 3 Testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {reviews.slice(0, 3).map((review) => (
        <div class="relative flex flex-col justify-between rounded-[28px] bg-white border border-[#F3E5CE] p-7 shadow-[0_4px_20px_rgba(232,93,4,0.04)] hover:shadow-[0_12px_30px_rgba(232,93,4,0.08)] transition-all duration-300">
          
          <div>
            <!-- Header de la Card con Avatar y Verificación -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-[#FFF7ED] text-[#EA580C] font-black text-sm flex items-center justify-center border border-[#FED7AA]">
                  {review.name.charAt(0)}
                </div>
                <div>
                  <h4 class="text-sm font-black text-[#3D2314] flex items-center gap-1.5">
                    {review.name}
                    {review.verified && (
                      <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-emerald-500 text-white text-[10px]" title="Compra verificada">
                        ✓
                      </span>
                    )}
                  </h4>
                  <p class="text-[11px] text-[#8F6F5B]">{review.date}</p>
                </div>
              </div>

              <!-- Estrellas -->
              <div class="flex text-[#F59E0B] gap-0.5">
                {Array.from({ length: review.rating || 5 }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            </div>

            <!-- Título de la reseña -->
            {review.title && (
              <h5 class="text-sm font-bold text-[#3D2314] mb-2">
                "{review.title}"
              </h5>
            )}

            <!-- Comentario -->
            <p class="text-xs sm:text-sm text-[#694A38] leading-relaxed italic">
              "{review.comment}"
            </p>
          </div>

          <!-- Miniatura Jirafa en esquina inferior derecha -->
          <div class="mt-6 pt-4 border-t border-[#F8EFE7] flex justify-end">
            <img
              src="/images/home/giraffe-winter.png"
              alt="Girafkids"
              class="w-8 h-8 object-contain opacity-80 hover:opacity-100 transition-opacity"
              onerror="this.src='/images/home/giraffe-winter.svg'"
            />
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
