---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (homeContent[lang] ?? homeContent.es).trustReasons;
const featured = t.featuredCard;
---

<section id="defensas" class="py-16 sm:py-24 bg-[#FFFBF2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección con Subrayado Curvo en Girafkids -->
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <h2 class="text-3xl sm:text-5xl font-black text-[#3D2314] tracking-tight leading-tight">
        <span>{t.titleBefore}</span>{" "}
        <span class="relative inline-block text-[#EA580C]">
          <span>{t.titleHighlight}</span>
          <!-- Subrayado trazo a mano en naranja idéntico a Figma -->
          <svg
            class="absolute -bottom-2 left-0 w-full h-3 text-[#EA580C] overflow-visible"
            viewBox="0 0 100 12"
            fill="none"
            preserveAspectRatio="none"
          >
            <path
              d="M2 8C25 2 75 2 98 8"
              stroke="currentColor"
              stroke-width="3.5"
              stroke-linecap="round"
            />
          </svg>
        </span>{" "}
        <span>{t.titleAfter}</span>
      </h2>
      <p class="text-sm sm:text-base text-[#694A38] leading-relaxed pt-2">
        {t.subtitle}
      </p>
    </div>

    <!-- Layout Asimétrico: Card Principal Naranja (Izquierda) + Grid 2x2 (Derecha) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Columna Izquierda (lg:col-span-5): Card 01 Grande Naranja Destacada -->
      <div class="lg:col-span-5 flex">
        <div class="relative w-full rounded-[32px] bg-gradient-to-br from-[#EA580C] to-[#D9480F] p-8 sm:p-10 text-white shadow-[0_12px_36px_rgba(234,88,12,0.25)] flex flex-col justify-between overflow-hidden">
          
          <!-- Fondo decorativo sutil -->
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-xl pointer-events-none"></div>

          <!-- Header de la Card 01 -->
          <div>
            <div class="flex items-center justify-between gap-4 mb-8">
              <!-- Ícono de Matraz Químico / Nutrición -->
              <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-sm border border-white/30 flex items-center justify-center text-white text-xl shadow-sm">
                <svg class="w-6 h-6 stroke-current fill-none" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 7h-6L8 4z" />
                </svg>
              </div>

              <!-- Badge y Número 01 Grande -->
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 text-[10px] font-black uppercase tracking-wider text-white">
                  {featured.badge}
                </span>
                <span class="text-4xl sm:text-5xl font-black text-white/30 select-none leading-none">
                  {featured.number}
                </span>
              </div>
            </div>

            <!-- Título y Descripción -->
            <div class="space-y-4">
              <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">
                {featured.title}
              </h3>
              <p class="text-sm sm:text-base text-white/90 leading-relaxed font-normal">
                {featured.desc}
              </p>
            </div>
          </div>

          <!-- Footer de la Card 01 -->
          <div class="pt-8 mt-6 border-t border-white/20 flex items-center justify-between gap-2 text-xs">
            <span class="font-bold text-white flex items-center gap-1.5">
              <span>✓</span>
              <span>{featured.featureTag}</span>
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-xl bg-black/20 backdrop-blur-sm border border-white/15 text-[11px] font-black text-white">
              {featured.gradeTag}
            </span>
          </div>

        </div>
      </div>

      <!-- Columna Derecha (lg:col-span-7): Grid 2x2 para Cards 02, 03, 04, 05 -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {t.items.map((item) => (
          <div class="rounded-[28px] bg-white border border-[#F3E5CE] p-6 sm:p-7 shadow-[0_4px_20px_rgba(232,93,4,0.04)] hover:shadow-[0_10px_28px_rgba(232,93,4,0.08)] hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
            
            <div>
              <!-- Header de la Card con Ícono y Número Naranja Pastel -->
              <div class="flex items-center justify-between mb-4">
                <!-- Íconos Temáticos -->
                <div class="w-11 h-11 rounded-2xl bg-[#FFF7ED] border border-[#FED7AA]/60 flex items-center justify-center text-[#EA580C]">
                  {item.icon === "smile" && (
                    <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                  {item.icon === "flash" && (
                    <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  )}
                  {item.icon === "shield" && (
                    <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  )}
                  {item.icon === "sparkle" && (
                    <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                  )}
                </div>

                <!-- Número Pastel -->
                <span class="text-2xl font-black text-[#FDBA74] tracking-tight">
                  {item.number}
                </span>
              </div>

              <!-- Título -->
              <h3 class="text-base sm:text-lg font-black text-[#3D2314] mb-2 leading-snug">
                {item.title}
              </h3>

              <!-- Descripción -->
              <p class="text-xs sm:text-sm text-[#694A38] leading-relaxed mb-4">
                {item.desc}
              </p>
            </div>

            <!-- Footer: Tag con Punto Naranja -->
            <div class="pt-2 border-t border-[#F8EFE7]">
              <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#EA580C]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#EA580C]"></span>
                <span>{item.tag}</span>
              </span>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>
