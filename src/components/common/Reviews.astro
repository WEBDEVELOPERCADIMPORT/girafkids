---
import type { Lang } from "../../i18n/config.i18n";
import homeContent from "../../data/site-home-content.json";

export interface Review {
  name: string;
  comment: string;
  rating: number;
  date: string;
  title?: string;
  verified?: boolean;
}

interface ReviewsProps {
  title?: string;
  lang?: Lang;
  reviews: Review[] | null;
}

const { title, lang = "es", reviews } = Astro.props as ReviewsProps;
const t = (homeContent[lang] ?? homeContent.es).reviews;
---

<section id="opiniones" class="w-full bg-[#FFFBF2] py-14 sm:py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    
    <!-- Header Idéntico a la Imagen de Referencia -->
    <header class="mb-12 flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-14 text-center sm:text-left">
      
      <!-- Bloque Izquierdo: 4.8 + Estrellas + Valoraciones -->
      <div class="flex items-center gap-3.5">
        <!-- Número 4.8 en Verde Oscuro Destacado -->
        <span class="text-4xl sm:text-5xl font-black text-[#164E30] tracking-tight leading-none">
          {t.score || "4.8"}
        </span>

        <!-- Estrellas y Subtítulo de Valoraciones -->
        <div class="flex flex-col items-start gap-1">
          <!-- 5 Estrellas Doradas con Delineado -->
          <div class="flex text-[#F59E0B] gap-1">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Texto de Valoraciones con Logo de Amazon en lugar de texto escrito -->
          <div class="flex items-center gap-1.5 text-xs text-[#8F6F5B] font-semibold">
            <span>{t.ratingCount}</span>
            <img
              src="/images/home/amazon.png"
              alt="Amazon"
              class="h-3.5 sm:h-4 w-auto object-contain inline-block"
            />
          </div>
        </div>
      </div>

      <!-- Bloque Derecho: Imagen Oficial de Amazon -->
      <div class="flex items-center">
        <img
          src="/images/home/amazon.png"
          alt="Amazon Reviews"
          class="h-9 sm:h-12 w-auto object-contain"
        />
      </div>

    </header>

    <!-- Carrusel de Reviews -->
    <div class="relative group review-carousel-container w-full">
      
      <!-- Botón Anterior Naranja -->
      <button
        type="button"
        class="prev-btn absolute left-1 sm:left-2 lg:-left-6 top-1/2 -translate-y-1/2 -ml-2 lg:-ml-6 z-10 bg-white rounded-full p-2.5 shadow-[0_4px_12px_rgba(232,93,4,0.15)] text-[#EA580C] hover:bg-[#FFF7ED] hover:scale-105 transition-all focus:outline-none border border-[#F3E5CE]"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Track de Desplazamiento -->
      <div class="review-track w-full flex overflow-x-hidden snap-x snap-mandatory gap-6 pb-6 pt-2 px-2 no-scrollbar scroll-smooth">
        {reviews?.map((review) => (
          <div class="snap-center shrink-0 w-[310px] sm:w-[350px] md:w-[370px] bg-white border border-[#F3E5CE] rounded-[32px] p-7 shadow-[0_4px_24px_-8px_rgba(232,93,4,0.08)] flex flex-col justify-between">
            <div>
              <!-- Info del Usuario -->
              <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-full bg-[#FFF7ED] border border-[#FED7AA] flex items-center justify-center text-[#EA580C] font-black text-lg">
                    {review.name.charAt(0)}
                  </div>
                  <div class="flex flex-col">
                    <h3 class="font-black text-[#3D2314] text-[15px] leading-tight">
                      {review.name}
                    </h3>
                    <p class="text-[12px] text-[#8F6F5B] mt-0.5">
                      {review.date}
                    </p>
                  </div>
                </div>

                <div class="bg-blue-500 rounded-full w-4 h-4 flex items-center justify-center" title="Compra verificada">
                  <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
              </div>

              <!-- Estrellas de la Card -->
              <div class="flex text-[#F59E0B] gap-0.5 mb-3">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg
                    class={`w-4 h-4 ${i < (review.rating || 5) ? "fill-current" : "text-gray-300 fill-current"}`}
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              <!-- Título de la Reseña si existe -->
              {review.title && (
                <h4 class="font-bold text-sm text-[#3D2314] mb-2 leading-snug">
                  "{review.title}"
                </h4>
              )}

              <!-- Comentario -->
              <p class="text-[13px] sm:text-[14px] text-[#694A38] leading-relaxed font-normal">
                "{review.comment}"
              </p>
            </div>

            <!-- Jirafa en esquina inferior del comentario (más grande) -->
            <div class="mt-6 pt-3 border-t border-[#F8EFE7] flex justify-end">
              <img
                src="/images/home/giraffe-coment.png"
                alt="Girafkids"
                class="w-16 h-16 sm:w-20 sm:h-20 object-contain hover:scale-105 transition-transform drop-shadow-xs"
                onerror="this.src='/images/home/giraffe-winter.png'"
              />
            </div>

          </div>
        ))}
      </div>

      <!-- Botón Siguiente Naranja -->
      <button
        type="button"
        class="next-btn absolute right-1 sm:right-2 lg:-right-6 top-1/2 -translate-y-1/2 -mr-2 lg:-mr-6 z-10 bg-white rounded-full p-2.5 shadow-[0_4px_12px_rgba(232,93,4,0.15)] text-[#EA580C] hover:bg-[#FFF7ED] hover:scale-105 transition-all focus:outline-none border border-[#F3E5CE]"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

    </div>

  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function setupCarousels() {
    const carousels = document.querySelectorAll(".review-carousel-container");

    carousels.forEach((container) => {
      const track = container.querySelector(".review-track");
      const prevBtn = container.querySelector(".prev-btn");
      const nextBtn = container.querySelector(".next-btn");

      if (!track || !prevBtn || !nextBtn) return;

      const scrollAmount = 370;

      prevBtn.addEventListener("click", () => {
        track.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      });

      nextBtn.addEventListener("click", () => {
        track.scrollBy({ left: scrollAmount, behavior: "smooth" });
      });
    });
  }

  setupCarousels();
  document.addEventListener("astro:page-load", setupCarousels);
</script>
