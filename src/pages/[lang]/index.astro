---
// src/pages/[lang]/index.astro
import Layout from "../../layouts/Layout.astro";
import homeContent from "../../data/site-home-content.json";
import { LANGUAGES, type Lang } from "../../i18n/config.i18n";
import { actions } from "astro:actions";

import Hero from "../../components/home/sections/Hero.astro";
import TrustReasons from "../../components/home/sections/TrustReasons.astro";
import ProductShowcase from "../../components/home/sections/ProductShowcase.astro";
import KidsEnergyBanner from "../../components/home/sections/KidsEnergyBanner.astro";
import Reviews from "../../components/common/Reviews.astro";
import StoreLocator from "../../components/home/sections/StoreLocator.astro";
import FAQ from "../../components/home/sections/FAQ.astro";

const lang = Astro.params.lang as Lang;

// 1. Validar idioma soportado
if (!(lang in LANGUAGES) || !(lang in homeContent)) {
  return Astro.redirect("/404");
}

const content = homeContent[lang];

// 2. Consultar Server Actions de AutoUI para el idioma correspondiente
const [{ data: productsResponse }, { data: reviewsResponse }, { data: storesResponse }] =
  await Promise.all([
    Astro.callAction(actions.getProducts, { lang }),
    Astro.callAction(actions.getReviews, {}),
    Astro.callAction(actions.getStores, {}),
  ]);

const products = productsResponse?.data ?? [];
const reviews = reviewsResponse?.data ?? [];
const stores = storesResponse?.data ?? [];
---

<Layout
  title={content.brandName}
  lang={lang}
  description={content.meta?.description}
  image="/images/home/giraffe-winter.png"
>
  <!-- Hero Section -->
  <Hero lang={lang} />

  <!-- 5 Razones para Confiar -->
  <TrustReasons lang={lang} />

  <!-- Catálogo Destacado / Suplementos (Carrusel Horizontal) -->
  <ProductShowcase lang={lang} products={products} />

  <!-- Banner Promocional Niños Energía -->
  <KidsEnergyBanner lang={lang} />

  <!-- Prueba Social & Reseñas Amazon usando common/Reviews.astro -->
  <Reviews lang={lang} reviews={reviews} />

  <!-- Localizador de Farmacias por ZIP -->
  <StoreLocator lang={lang} stores={stores} />

  <!-- Preguntas Frecuentes -->
  <FAQ lang={lang} />
</Layout>
