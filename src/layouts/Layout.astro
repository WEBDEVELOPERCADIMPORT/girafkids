---
import type { Lang } from "../i18n/config.i18n";
import { LANGUAGES } from "../i18n/config.i18n";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	lang: Lang;
	description?: string;
	image?: string;
	schema?: object;
	canonicalPath?: string;
}

const {
	title,
	lang,
	description = "Girafkids® - Suplementos infantiles de grado pediátrico en formato líquido para el cuidado y defensas de tus pequeños.",
	image = "/icon.png",
	schema,
	canonicalPath,
} = Astro.props;

const baseUrl = "https://girafkids.com";

const baseRoute =
	canonicalPath !== undefined
		? canonicalPath
		: Astro.url.pathname.replace(/^\/[a-z]{2}(\/|$)/, "");
const cleanRoute = baseRoute.startsWith("/") ? baseRoute.slice(1) : baseRoute;

const canonicalURL = new URL(
	`/${lang}${cleanRoute ? `/${cleanRoute}` : ""}`,
	baseUrl,
).href;
const socialImageURL = new URL(image, Astro.url.origin).href;

const alternateLinks = Object.keys(LANGUAGES).map((l) => ({
	lang: l,
	url: new URL(`/${l}${cleanRoute ? `/${cleanRoute}` : ""}`, baseUrl).href,
}));
const defaultLink = new URL(`/es${cleanRoute ? `/${cleanRoute}` : ""}`, baseUrl)
	.href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#E85D04" />
		<link rel="icon" type="image/png" href="/icon.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="54c1f19f-cf67-4430-85bf-985e16a7a95a"></script>

		<!-- Google Fonts: Sour Gummy -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sour+Gummy:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>

		<link rel="canonical" href={canonicalURL} />
		{
			alternateLinks.map(({ lang: l, url }) => (
				<link rel="alternate" hreflang={l} href={url} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={defaultLink} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Girafkids" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<meta name="apple-mobile-web-app-title" content="Girafkids" />
		<meta name="application-name" content="Girafkids" />
		<ClientRouter />

		{
			schema && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(schema)}
				/>
			)
		}
	</head>
	<body
		class="bg-[#FFFBF2] text-[#694A38] antialiased min-h-screen flex flex-col font-sans selection:bg-[#FDBA2A] selection:text-[#7C2D12]"
	>
		<Navbar lang={lang} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.3s;
	}
</style>
